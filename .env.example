# Local Compose Postgres. Replace with the Neon connection URL to use Neon.
# Standard postgresql:// Neon URLs (including sslmode/channel_binding options)
# are normalized to SQLAlchemy's asyncpg driver by the backend.
DATABASE_URL=postgresql+asyncpg://workflow:workflow@postgres:5432/workflow
POLL_INTERVAL_SECONDS=0.5
LEASE_SECONDS=15
WORKER_CONCURRENCY=4
ENVIRONMENT=development
API_PORT=8000
